[node name="GalleryPhoto1" type="StaticBody3D" parent="Room_KimiNiTodoke"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -16.7, 2.5, -21.4)
script = ExtResource("2_interactable")
prompt_text = "Lihat Foto Kenangan"
exhibit_title = "Ketulusan Senyuman Sawako"
exhibit_description = "Sawako adalah definisi jiwa paling murni. Walaupun sering ditakuti dan dijauhi teman sekelas karena penampilannya yang mirip tokoh horor, dia tidak pernah menaruh dendam. Dia selalu bangun paling pagi untuk membersihkan kelas dan menyiram tanaman sekolah."

