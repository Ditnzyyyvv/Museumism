[node name="BioLectern" type="StaticBody3D" parent="Room_KimiNiTodoke"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -9.0, 0, -25.2)
script = ExtResource("2_interactable")
prompt_text = "Baca Kisah Karakter"
exhibit_title = "Kenangan Kimi ni Todoke: Ketulusan & Cinta Pertama"
exhibit_description = "Kimi ni Todoke mengajarkanku kekuatan luar biasa dari ketulusan tanpa pamrih.\n\nDi dunia yang penuh dengan kepura-puraan dan penilaian dangkal dari penampilan luar, Sawako membuktikan bahwa kebaikan yang tulus pada akhirnya akan 'sampai' ke hati orang lain.\n\nKisah ini selalu menghangatkan hatiku saat aku merasa disalahpahami, mengingatkanku bahwa tidak ada kebaikan yang sia-sia jika dilakukan dengan hati yang bersih."

