script = ExtResource("2_interactable")
prompt_text = "Lihat Foto Kenangan"
exhibit_title = "WALL-E & Jiwa Penjelajah"
exhibit_description = "Meskipun hanya sebuah mesin pemadat rongsokan, WALL-E mengembangkan jiwa penjelajah yang menakjubkan. Dia mengoleksi pemantik api kuno, kubus rubik warna-warni, bola lampu, dan rekaman kaset film musikal 'Hello, Dolly!'. Dia merawat hal-hal kecil yang terlupakan dengan penuh kelembutan rasa ingin tahu."

