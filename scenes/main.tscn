[node name="WelcomeDesk" type="StaticBody3D" parent="Exhibits"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 7.5)
script = ExtResource("2_interactable")
prompt_text = "Baca Panduan Museum"
exhibit_title = "Selamat Datang di Museum Kimi ni Todoke"
exhibit_description = "Selamat datang di pameran seni dan artifak. Di ruang ini Anda dapat bereksplorasi secara leluasa.\n• WASD: Berjalan santai\n• Shift: Berlari\n• E: Berinteraksi dan membaca kisah setiap karya seni."

