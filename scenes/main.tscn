[node name="SanctuaryLectern" type="StaticBody3D" parent="GrandHallway"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -52.0)
script = ExtResource("2_interactable")
prompt_text = "Baca Renungan Akhir"
exhibit_title = "Sanctuary of Stories: Renungan Akhir"
exhibit_description = "Karakter fiksi bukan sekadar bayangan semu di layar kaca. Mereka adalah teman setia yang menemani kita melewati malam-malam paling sepi, memberi kita tawa saat kita lupa cara tersenyum, dan memberi kita keberanian untuk menghadapi hari esok.

• WALL-E mengajarkan cinta tanpa syarat & harapan abadi.
• Shoko & Shoya mengajarkan pengampunan dan penerimaan diri.
• Sawako mengajarkan ketulusan yang tak tergoyahkan.
• Josee mengajarkan keberanian untuk berenang di samudra impian.

Terima kasih telah hadir dan hidup di dalam hatiku selamanya."

