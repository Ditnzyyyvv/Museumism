transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 13.5, 0, -14)
script = ExtResource("2_interactable")
prompt_text = "Baca Catatan Shoko"
exhibit_title = "Memorial Kolam Koi & Buku Catatan Hati"
exhibit_description = "Memorial kolam zen dengan jembatan kayu kecil, guguran kelopak sakura, dan buku catatan komunikasi Shoko yang bercahaya lembut.\n\nMenyimbolkan keberanian untuk memaafkan mereka yang pernah menyakiti kita, dan yang terpenting: keberanian untuk memaafkan diri sendiri."

