prompt_text = "Lihat Info Section 02"
exhibit_title = "Section 02: A Silent Voice (2016) — Sakura & River"
exhibit_description = "Gerbang menuju sayap penghormatan A Silent Voice (聲の形). Didekorasi dengan kelopak bunga sakura, riak air jernih Sungai Suimon, dan simbol siluet X yang terlepas saat seseorang menemukan keberanian untuk mendengar suara hati orang lain."

