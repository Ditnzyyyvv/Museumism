[node name="BioLectern" type="StaticBody3D" parent="Room_WallE"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -9.0, 0, 2.8)
script = ExtResource("2_interactable")
prompt_text = "Baca Kisah Karakter"
exhibit_title = "Kenangan WALL-E: Makna Kesetiaan & Cinta Tulus"
exhibit_description = "WALL-E bukan sekadar film animasi fiksi ilmiah biasa bagi hidupku.\n\nKarakter WALL-E mengajarkan arti kesendirian yang indah: bagaimana di tengah dunia yang hancur dan sepi, dia tetap menyimpan jiwa yang hangat, mendengarkan lagu cinta lama, merawat kecoak kecil temannya, dan menjaga rasa ingin tahu yang murni.\n\nKetika dia bertemu EVE, dia memberikan segalanya tanpa pamrih. Dia mengajarkanku bahwa cinta sejati bukanlah kata-kata mutiara rumit, melainkan tindakan nyata: memegang tangan seseorang, melindunginya dari hujan petir, dan menolak untuk menyerah pada harapan sekecil apa pun."

