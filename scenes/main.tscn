transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -13.5, 0, 0)
script = ExtResource("2_interactable")
prompt_text = "Amati WALL-E & Tunas Hijau"
exhibit_title = "Monumen WALL-E & Tunas Hijau Dalam Sepatu"
exhibit_description = "Patung memorial WALL-E yang menggenggam sebuah sepatu boot bekas berisi tunas tanaman hijau kecil yang masih hidup.\n\nTunas ini adalah bukti bahwa kehidupan selalu menemukan jalannya kembali. WALL-E mengajarkan kita untuk tidak hanya 'bertahan hidup' (survive), melainkan benar-benar 'hidup' (live)."

