prompt_text = "Lihat Info Section 01"
exhibit_title = "Section 01: WALL-E (2008) — Deep Space"
exhibit_description = "Gerbang menuju sayap penghormatan WALL-E. Tembok dihiasi tema kosmik luar angkasa dengan nebula dan taburan bintang abadi, melambangkan perjalanan cinta tulus WALL-E dan EVE yang menyeberangi galaksi."

